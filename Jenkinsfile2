pipeline {
    agent any
    stages{
        stage('Get User Input'){
            steps{
                script{
                    imageNumber = input(
                        id: 'Rollback',
                        message: 'What image do you want to rollback to?:',
                        parameters: [string(name: 'imageNumber', defaultValue: '0')]
                    )
                }
            }
        }
        
        stage('Rollback image'){
            steps{
                script{
                    def containerName =" simplecalculator"
                    
                    try{
                        bat "docker stop ${containerName}"
                        bat "docker rm ${containerName}"
                    }catch(Exception ex){
                        echo "container ${containerName} isn't running"
                    }
                    
                    def previousImage = docker.image("braxtonjazz/simplecalculator:${imageNumber}")
                    previousImage.pull()
                    previousImage.run("-d --name ${containerName}")
                    def container = docker.build("braxtonjazz/simplecalculator:${env.BUILD_NUMBER}")
                    container.push()
            
                }
                // echo "Rolling back to image number: ${imageNumber}"
            }
        }
    }
}