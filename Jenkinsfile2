pipeline {
    agent any
    stages{
        stage('Get User Input'){
            steps{
                script{
                    imageNumber = input(
                        id: 'Rollback',
                        message: 'What image do you want to rollback to?:',
                        parameters: [string(name: 'imageNumber', defaultValue: '0')]
                    )
                }
            }
        }
        
        stage('Rollback image'){
            steps{
                script{
                    def containerName =" simplecalculator"
                    
                    def previousImage = "braxtonjazz/simplecalculator:${imageNumber}"
                    bat "docker pull ${previousImage}"
                    bat "docker tag ${previousImage} braxtonjazz/simplecalculator:${env.BUILD_NUMBER}"
                    bat "docker push braxtonjazz/simplecalculator:${env.BUILD_NUMBER}"
            
                }
                echo "Rolling back to image number: ${imageNumber}"
            }
        }
    }
}