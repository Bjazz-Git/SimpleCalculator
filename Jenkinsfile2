pipeline {
    agent any
    stages{
        stage('Rollback image'){
            steps{
                script{
                def previousImage = currentBuild.previousSuccessfulBuild
                def previousTag = ''
                if(previousImage){
                    previousTag = previousImage.number.toString()
                }
                else{
                    error "No previous build"
                }
                
                def imageToDeploy = "braxtonjazz/simpleCalculator:${previousTag}"
                //docker.build(imageToDeploy)
                
                echo "The image that is going to deploy is: ${imageToDeploy}"
                }
            }
        }
    }
}